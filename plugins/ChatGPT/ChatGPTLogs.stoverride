name: ChatGPT 本地日志
desc: 默认暂停；打开 http://chatgpt-logs.invalid/ 管理元数据日志。HTTPS 需 MitM；不缓冲聊天正文。
rules:
  - DOMAIN,chatgpt-logs.invalid,DIRECT
http:
  force-http-engine:
    - 'chatgpt-logs.invalid:80'
  mitm:
    - 'chatgpt.com:443'
    - '*.chatgpt.com:443'
    - 'openai.com:443'
    - '*.openai.com:443'
    - 'oaistatic.com:443'
    - '*.oaistatic.com:443'
    - 'oaiusercontent.com:443'
    - '*.oaiusercontent.com:443'
    - 'oaistatsig.com:443'
    - '*.oaistatsig.com:443'
    - 'openaimerge.com:443'
    - '*.openaimerge.com:443'
  script:
    - name: chatgpt-network-logger
      match: '^http://chatgpt-logs\.invalid(?::80)?(?:/|$)'
      type: request
      require-body: false
      timeout: 10
    - name: chatgpt-network-logger
      match: '^https://(?:[a-z0-9-]+\.)*(?:chatgpt\.com|openai\.com|oaistatic\.com|oaiusercontent\.com|oaistatsig\.com|openaimerge\.com)(?::443)?/'
      type: request
      require-body: false
      timeout: 10
    - name: chatgpt-network-logger
      match: '^https://(?:[a-z0-9-]+\.)*(?:chatgpt\.com|openai\.com|oaistatic\.com|oaiusercontent\.com|oaistatsig\.com|openaimerge\.com)(?::443)?/'
      type: response
      require-body: false
      timeout: 10
script-providers:
  chatgpt-network-logger:
    url: https://raw.githubusercontent.com/teaoea/shell/main/plugins/ChatGPT/ChatGPTLogger.js
    interval: 86400
