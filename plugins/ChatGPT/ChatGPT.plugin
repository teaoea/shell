#!name = ChatGPT 网络选择与本地日志
#!author = 可莉唯一的狗
#!icon = https://raw.githubusercontent.com/teaoea/shell/main/plugins/ChatGPT/assets/chatgpt.jpg
# 作者：可莉唯一的狗
#!desc = 试验版：尝试将插件内策略名称改为网络模式；请确认出现手动选择入口并核对实际规则命中，不生效则回滚；日志工具默认关闭，本地页面支持查看与导出。默认不解密 ChatGPT，避免原生 App 证书错误；HTTPS 自定义日志仅适用于手动开启解密的浏览器调试。
#!homepage = https://github.com/teaoea/shell/blob/main/plugins/ChatGPT/README.md
#!loon_version = 3.5.1(983)
[Argument]
log_enabled = switch,false,tag=日志工具,desc=开启后允许元数据采样；首次开启后在本地日志页点击开启日志，关闭后停止采样但仍可导出；默认不解密，原生 App 请使用 Loon 连接记录
[Rule]
DOMAIN-SUFFIX,chatgpt.com,网络模式
DOMAIN-SUFFIX,openai.com,网络模式
DOMAIN-SUFFIX,oaistatic.com,网络模式
DOMAIN-SUFFIX,oaiusercontent.com,网络模式
DOMAIN-SUFFIX,oaistatsig.com,网络模式
DOMAIN-SUFFIX,openaimerge.com,网络模式
DOMAIN,challenges.cloudflare.com,网络模式
DOMAIN,cdn.workos.com,网络模式
DOMAIN,forwarder.workos.com,网络模式
DOMAIN,frontend-apps-multi-region.workos.com,网络模式
DOMAIN,images.workoscdn.com,网络模式
DOMAIN,setup.workos.com,网络模式
DOMAIN,workos.imgix.net,网络模式
DOMAIN,chatgpt-logs.invalid,DIRECT
[Script]
http-request ^http://chatgpt-logs\.invalid(?::80)?(?:/|$) script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/ChatGPT/ChatGPTLogger.js,argument=[{log_enabled}],requires-body=false,timeout=10,tag=ChatGPT 日志页面
http-request ^https://(?:[a-z0-9-]+\.)*(?:chatgpt\.com|openai\.com|oaistatic\.com|oaiusercontent\.com|oaistatsig\.com|openaimerge\.com)(?::443)?/ script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/ChatGPT/ChatGPTLogger.js,argument=[{log_enabled}],enable={log_enabled},requires-body=false,timeout=10,tag=ChatGPT 请求日志
http-response ^https://(?:[a-z0-9-]+\.)*(?:chatgpt\.com|openai\.com|oaistatic\.com|oaiusercontent\.com|oaistatsig\.com|openaimerge\.com)(?::443)?/ script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/ChatGPT/ChatGPTLogger.js,argument=[{log_enabled}],enable={log_enabled},requires-body=false,timeout=10,tag=ChatGPT 响应日志
