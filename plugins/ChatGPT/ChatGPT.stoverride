name: ChatGPT 网络选择与本地日志
desc: 在 ChatGPT 策略组选择 DIRECT 或代理节点；日志默认暂停，访问 http://chatgpt-logs.invalid/ 管理。HTTPS 日志需解密；暂停不移除 MitM 主机。
proxy-groups:
  - name: ChatGPT
    type: select
    proxies:
      - DIRECT
    include-all: true
rules:
  - DOMAIN-SUFFIX,chatgpt.com,ChatGPT
  - DOMAIN-SUFFIX,openai.com,ChatGPT
  - DOMAIN-SUFFIX,oaistatic.com,ChatGPT
  - DOMAIN-SUFFIX,oaiusercontent.com,ChatGPT
  - DOMAIN-SUFFIX,oaistatsig.com,ChatGPT
  - DOMAIN-SUFFIX,openaimerge.com,ChatGPT
  - DOMAIN,challenges.cloudflare.com,ChatGPT
  - DOMAIN,cdn.workos.com,ChatGPT
  - DOMAIN,forwarder.workos.com,ChatGPT
  - DOMAIN,frontend-apps-multi-region.workos.com,ChatGPT
  - DOMAIN,images.workoscdn.com,ChatGPT
  - DOMAIN,setup.workos.com,ChatGPT
  - DOMAIN,workos.imgix.net,ChatGPT
  - DOMAIN,chatgpt-logs.invalid,DIRECT
http:
  force-http-engine:
    - 'chatgpt-logs.invalid:80'
  mitm:
    - 'chatgpt.com:443'
    - '*.chatgpt.com:443'
    - 'openai.com:443'
    - '*.openai.com:443'
    - 'oaistatic.com:443'
    - '*.oaistatic.com:443'
    - 'oaiusercontent.com:443'
    - '*.oaiusercontent.com:443'
    - 'oaistatsig.com:443'
    - '*.oaistatsig.com:443'
    - 'openaimerge.com:443'
    - '*.openaimerge.com:443'
  script:
    - name: chatgpt-network-logger
      match: '^http://chatgpt-logs\.invalid(?::80)?(?:/|$)'
      type: request
      require-body: false
      timeout: 10
    - name: chatgpt-network-logger
      match: '^https://(?:[a-z0-9-]+\.)*(?:chatgpt\.com|openai\.com|oaistatic\.com|oaiusercontent\.com|oaistatsig\.com|openaimerge\.com)(?::443)?/'
      type: request
      require-body: false
      timeout: 10
    - name: chatgpt-network-logger
      match: '^https://(?:[a-z0-9-]+\.)*(?:chatgpt\.com|openai\.com|oaistatic\.com|oaiusercontent\.com|oaistatsig\.com|openaimerge\.com)(?::443)?/'
      type: response
      require-body: false
      timeout: 10
script-providers:
  chatgpt-network-logger:
    url: https://raw.githubusercontent.com/teaoea/shell/main/plugins/ChatGPT/ChatGPTLogger.js
    interval: 86400
