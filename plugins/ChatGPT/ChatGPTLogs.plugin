#!name = ChatGPT 本地日志
#!desc = 在 http://chatgpt-logs.invalid/ 开启、暂停、导出、清空；默认暂停，仅保留最近 300 条元数据。HTTPS 需 MitM；原生客户端可能拒绝解密。
[Rule]
DOMAIN,chatgpt-logs.invalid,DIRECT
[Script]
http-request ^http://chatgpt-logs\.invalid(?::80)?(?:/|$) script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/ChatGPT/ChatGPTLogger.js,requires-body=false,timeout=10,tag=ChatGPT 日志页面
http-request ^https://(?:[a-z0-9-]+\.)*(?:chatgpt\.com|openai\.com|oaistatic\.com|oaiusercontent\.com|oaistatsig\.com|openaimerge\.com)(?::443)?/ script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/ChatGPT/ChatGPTLogger.js,requires-body=false,timeout=10,tag=ChatGPT 请求日志
http-response ^https://(?:[a-z0-9-]+\.)*(?:chatgpt\.com|openai\.com|oaistatic\.com|oaiusercontent\.com|oaistatsig\.com|openaimerge\.com)(?::443)?/ script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/ChatGPT/ChatGPTLogger.js,requires-body=false,timeout=10,tag=ChatGPT 响应日志
[Mitm]
hostname = chatgpt.com, *.chatgpt.com, openai.com, *.openai.com, oaistatic.com, *.oaistatic.com, oaiusercontent.com, *.oaiusercontent.com, oaistatsig.com, *.oaistatsig.com, openaimerge.com, *.openaimerge.com
