#!name = 搜索结果网站屏蔽
#!icon = https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/assets/search-filter.jpg
#!author = 可莉唯一的狗、ChatGPT
#!desc = v1.1.0；隐藏命中黑名单的搜索结果，支持 Google、Bing、百度、DuckDuckGo、Yahoo、Brave、Yandex、搜狗、360、神马、Ecosia、Startpage。使用：开启 Loon 脚本与 HTTPS MitM 并信任证书；运行“添加黑名单”，点击通知打开本地网页；勾选引擎，使用 domain-keyword 或 domain-suffix 添加规则，冒号后留空格、每行一条，保存后重新搜索。新增引擎默认未勾选；不支持通配符。订阅与额外搜索排除在网页设置；脱敏日志默认关闭。未知布局或目标域名不明时保留结果。
#!system = iOS,iPadOS,macOS
#!homepage = https://github.com/teaoea/shell/blob/main/plugins/SearchFilter/README.md
#!tag = 搜索,网站屏蔽

[Argument]
log_enabled = switch,false,tag=日志工具,desc=默认关闭；开启后自动记录并通知打开本地日志页；首次匹配请求或每分钟本地检查时生效；暂停后可在日志页恢复；不保存搜索词及完整 URL、标题正文、凭据、黑名单或订阅地址；关闭后停止采样但保留日志供导出

[Rule]
DOMAIN,search-filter-logs.invalid,DIRECT
DOMAIN,search-filter-list.invalid,DIRECT

[Script]
http-request ^http://search-filter-list\.invalid(?::80)?(?:/|$) script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterEditor.js?v=1.1.0,requires-body=true,timeout=15,argument=[{log_enabled}],tag=搜索屏蔽名单页面
generic script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterEditor.js?v=1.1.0,timeout=10,tag=添加黑名单,img-url=plus.circle.system
cron "* * * * *" script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterLogWatch.js?v=1.1.0,timeout=5,argument=[{log_enabled}],tag=搜索屏蔽日志开关状态检查
http-request ^http://search-filter-logs\.invalid(?::80)?(?:/|$) script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterLogger.js?v=1.1.0,requires-body=true,timeout=10,argument=[{log_enabled}],tag=搜索屏蔽日志页面与导出
generic script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterLogger.js?v=1.1.0,timeout=10,argument=[{log_enabled}],tag=搜索屏蔽开发日志,img-url=doc.text.magnifyingglass.system
cron "0 * * * *" script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterSubscription.js?v=1.1.0,timeout=15,argument=[{log_enabled}],tag=搜索屏蔽订阅定时更新
http-request ^https://(?:google\.com|www\.google\.com|google\.com\.hk|www\.google\.com\.hk|google\.com\.tw|www\.google\.com\.tw|google\.co\.jp|www\.google\.co\.jp|google\.co\.uk|www\.google\.co\.uk)(?::443)?(?:/search)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilter.js?v=1.1.0,requires-body=false,timeout=5,argument=[{log_enabled}],tag=Google 搜索网站排除
http-request ^https://(?:bing\.com|www\.bing\.com|cn\.bing\.com)(?::443)?(?:/search)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilter.js?v=1.1.0,requires-body=false,timeout=5,argument=[{log_enabled}],tag=Bing 搜索网站排除
http-request ^https://(?:baidu\.com|www\.baidu\.com|m\.baidu\.com)(?::443)?(?:/s)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilter.js?v=1.1.0,requires-body=false,timeout=5,argument=[{log_enabled}],tag=百度 搜索网站排除
http-request ^https://(?:duckduckgo\.com|www\.duckduckgo\.com|safe\.duckduckgo\.com|start\.duckduckgo\.com|noai\.duckduckgo\.com|html\.duckduckgo\.com)(?::443)?(?:/|/html|/html/)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilter.js?v=1.1.0,requires-body=false,timeout=5,argument=[{log_enabled}],tag=DuckDuckGo 搜索网站排除
http-request ^https://(?:search\.yahoo\.com|uk\.search\.yahoo\.com|tw\.search\.yahoo\.com|hk\.search\.yahoo\.com|sg\.search\.yahoo\.com|search\.yahoo\.co\.jp)(?::443)?(?:/search)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilter.js?v=1.1.0,requires-body=false,timeout=5,argument=[{log_enabled}],tag=Yahoo 搜索网站排除
http-request ^https://(?:search\.brave\.com|safe\.search\.brave\.com)(?::443)?(?:/search)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilter.js?v=1.1.0,requires-body=false,timeout=5,argument=[{log_enabled}],tag=Brave 搜索网站排除
http-request ^https://(?:yandex\.com|www\.yandex\.com|yandex\.ru|www\.yandex\.ru|ya\.ru|www\.ya\.ru)(?::443)?(?:/search|/search/|/search/touch|/search/touch/)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilter.js?v=1.1.0,requires-body=false,timeout=5,argument=[{log_enabled}],tag=Yandex 搜索网站排除
http-request ^https://(?:sogou\.com|www\.sogou\.com|m\.sogou\.com)(?::443)?(?:/web|/web/searchList\.jsp)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilter.js?v=1.1.0,requires-body=false,timeout=5,argument=[{log_enabled}],tag=搜狗 搜索网站排除
http-request ^https://(?:so\.com|www\.so\.com|m\.so\.com)(?::443)?(?:/s)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilter.js?v=1.1.0,requires-body=false,timeout=5,argument=[{log_enabled}],tag=360 搜索网站排除
http-request ^https://(?:m\.sm\.cn|sm\.cn|www\.sm\.cn)(?::443)?(?:/s)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilter.js?v=1.1.0,requires-body=false,timeout=5,argument=[{log_enabled}],tag=神马 搜索网站排除
http-request ^https://(?:www\.ecosia\.org|ecosia\.org)(?::443)?(?:/search)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilter.js?v=1.1.0,requires-body=false,timeout=5,argument=[{log_enabled}],tag=Ecosia 搜索网站排除
http-request ^https://(?:www\.startpage\.com|startpage\.com)(?::443)?(?:/sp/search|/do/dsearch)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilter.js?v=1.1.0,requires-body=false,timeout=5,argument=[{log_enabled}],tag=Startpage 搜索网站排除
http-response ^https://(?:google\.com|www\.google\.com|google\.com\.hk|www\.google\.com\.hk|google\.com\.tw|www\.google\.com\.tw|google\.co\.jp|www\.google\.co\.jp|google\.co\.uk|www\.google\.co\.uk)(?::443)?(?:/search)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterResponse.js?v=1.1.0,requires-body=true,timeout=10,argument=[{log_enabled}],tag=Google 搜索页面过滤
http-response ^https://(?:bing\.com|www\.bing\.com|cn\.bing\.com)(?::443)?(?:/search)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterResponse.js?v=1.1.0,requires-body=true,timeout=10,argument=[{log_enabled}],tag=Bing 搜索页面过滤
http-response ^https://(?:baidu\.com|www\.baidu\.com|m\.baidu\.com)(?::443)?(?:/s)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterResponse.js?v=1.1.0,requires-body=true,timeout=10,argument=[{log_enabled}],tag=百度 搜索页面过滤
http-response ^https://(?:duckduckgo\.com|www\.duckduckgo\.com|safe\.duckduckgo\.com|start\.duckduckgo\.com|noai\.duckduckgo\.com|html\.duckduckgo\.com)(?::443)?(?:/|/html|/html/)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterResponse.js?v=1.1.0,requires-body=true,timeout=10,argument=[{log_enabled}],tag=DuckDuckGo 搜索页面过滤
http-response ^https://(?:search\.yahoo\.com|uk\.search\.yahoo\.com|tw\.search\.yahoo\.com|hk\.search\.yahoo\.com|sg\.search\.yahoo\.com|search\.yahoo\.co\.jp)(?::443)?(?:/search)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterResponse.js?v=1.1.0,requires-body=true,timeout=10,argument=[{log_enabled}],tag=Yahoo 搜索页面过滤
http-response ^https://(?:search\.brave\.com|safe\.search\.brave\.com)(?::443)?(?:/search)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterResponse.js?v=1.1.0,requires-body=true,timeout=10,argument=[{log_enabled}],tag=Brave 搜索页面过滤
http-response ^https://(?:yandex\.com|www\.yandex\.com|yandex\.ru|www\.yandex\.ru|ya\.ru|www\.ya\.ru)(?::443)?(?:/search|/search/|/search/touch|/search/touch/)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterResponse.js?v=1.1.0,requires-body=true,timeout=10,argument=[{log_enabled}],tag=Yandex 搜索页面过滤
http-response ^https://(?:sogou\.com|www\.sogou\.com|m\.sogou\.com)(?::443)?(?:/web|/web/searchList\.jsp)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterResponse.js?v=1.1.0,requires-body=true,timeout=10,argument=[{log_enabled}],tag=搜狗 搜索页面过滤
http-response ^https://(?:so\.com|www\.so\.com|m\.so\.com)(?::443)?(?:/s)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterResponse.js?v=1.1.0,requires-body=true,timeout=10,argument=[{log_enabled}],tag=360 搜索页面过滤
http-response ^https://(?:m\.sm\.cn|sm\.cn|www\.sm\.cn)(?::443)?(?:/s)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterResponse.js?v=1.1.0,requires-body=true,timeout=10,argument=[{log_enabled}],tag=神马 搜索页面过滤
http-response ^https://(?:www\.ecosia\.org|ecosia\.org)(?::443)?(?:/search)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterResponse.js?v=1.1.0,requires-body=true,timeout=10,argument=[{log_enabled}],tag=Ecosia 搜索页面过滤
http-response ^https://(?:www\.startpage\.com|startpage\.com)(?::443)?(?:/sp/search|/do/dsearch)\? script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/SearchFilter/SearchFilterResponse.js?v=1.1.0,requires-body=true,timeout=10,argument=[{log_enabled}],tag=Startpage 搜索页面过滤

[Mitm]
hostname = google.com, www.google.com, google.com.hk, www.google.com.hk, google.com.tw, www.google.com.tw, google.co.jp, www.google.co.jp, google.co.uk, www.google.co.uk, bing.com, www.bing.com, cn.bing.com, baidu.com, www.baidu.com, m.baidu.com, duckduckgo.com, www.duckduckgo.com, safe.duckduckgo.com, start.duckduckgo.com, noai.duckduckgo.com, html.duckduckgo.com, search.yahoo.com, uk.search.yahoo.com, tw.search.yahoo.com, hk.search.yahoo.com, sg.search.yahoo.com, search.yahoo.co.jp, search.brave.com, safe.search.brave.com, yandex.com, www.yandex.com, yandex.ru, www.yandex.ru, ya.ru, www.ya.ru, sogou.com, www.sogou.com, m.sogou.com, so.com, www.so.com, m.so.com, m.sm.cn, sm.cn, www.sm.cn, www.ecosia.org, ecosia.org, www.startpage.com, startpage.com
