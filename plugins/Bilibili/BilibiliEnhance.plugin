#!name = Bilibili 增强
#!author = 可莉唯一的狗、ChatGPT
#!icon = https://raw.githubusercontent.com/teaoea/shell/main/plugins/Bilibili/assets/bilibili.png
#!desc = 支持已识别的开屏及首页广告过滤、直播与游戏推荐过滤、导航精简、首页标签自选、编号排序、实时预览与手动添加、视频页广告过滤、播放中三连与关注浮层移除、我的页会员推广过滤、搜索框默认词清空、搜索热搜与发现隐藏、UP 主 UID 与标题关键词屏蔽，以及本地开发日志查看、导出和清空。
#!homepage = https://github.com/teaoea/shell/blob/main/plugins/Bilibili/README.md
#!tag = Bilibili,去广告,推荐过滤

[Argument]
hide_live = switch,false,tag=屏蔽直播内容,desc=默认关闭；开启后过滤首页、连续刷视频及视频页推荐中的已识别直播卡片，避免从推荐卡自动进入直播间；保存后重新打开 B 站并刷新推荐；手动直播入口保留
hide_game = switch,false,tag=隐藏游戏推广,desc=默认关闭；开启后刷新首页，隐藏游戏推荐卡片；重新打开 B 站可加载导航中的游戏中心隐藏结果
hide_member_shop = switch,false,tag=隐藏会员购入口,desc=默认关闭；开启后隐藏导航中的会员购入口，同时移除推荐流中可识别的会员购商品卡片；保存后刷新首页并重新打开 B 站；不改变会员权益
hide_publish = switch,false,tag=隐藏发布入口,desc=默认关闭；开启后重新打开 B 站，隐藏导航中的发布入口
hide_search_discovery = switch,false,tag=隐藏热搜与搜索发现,desc=默认关闭；开启后隐藏搜索框下方的热搜和搜索发现；保留搜索历史与正常搜索结果；保存后退出搜索页再进入，缓存内容可能需要重新打开 B 站
blocked_uids = input,"",tag=UP 主 UID 屏蔽名单,desc=填写数字 UID，多个用空格或逗号分隔，例如 12345 67890；保存后刷新推荐；首页、视频页及连续刷视频的已覆盖推荐共用此名单，按实际 UP 主 UID 匹配；留空停用
blocked_keywords = input,"",tag=标题关键词屏蔽,desc=填写要屏蔽的标题关键词，多个用逗号分隔，例如 抽奖，带货；保存后刷新推荐；首页、视频页及连续刷视频的已覆盖推荐共用此名单，按标题包含关键词过滤，英文不区分大小写；留空停用
log_enabled = switch,false,tag=开发日志,desc=默认关闭；开启后自动记录，刷新 B 站首页触发提醒，点击通知打开日志页；请先导出再关闭，关闭后在下一次请求、日志页访问或每分钟检查时自动清空记录；不保存令牌或正文

[Rule]
DOMAIN,bilibili-logs.invalid,DIRECT

[Script]
# 功能：每分钟检测日志开关，只在新开启时通知；点击通知打开浏览器。更新时间：2026-10-07
cron "* * * * *" script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/Bilibili/BilibiliEnhance.js?v=1.11.8,timeout=10,argument=[{log_enabled}],tag=Bilibili 日志开启提醒
generic script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/Bilibili/BilibiliEnhance.js?v=1.11.8,timeout=10,argument=[{log_enabled}],tag=Bilibili 打开日志页,img-url=doc.text.magnifyingglass.system
# 使用：运行此按钮并点击通知，在管理页点击“获取全部标签”，按目标顺序勾选标签，方框序号表示排序，预览同步更新；也可展开“手动添加标签”填写名称与 URL，添加后勾选并保存，再重新打开 B 站。
generic script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/Bilibili/BilibiliEnhance.js?v=1.11.8,timeout=10,argument=[{log_enabled}],tag=Bilibili 首页标签管理,img-url=line.3.horizontal.decrease.circle.system
# 功能：此规则处理已登记的 JSON API，不读取视频媒体。更新时间：2026-10-07
http-response ^https://(?:app\.bilibili\.com|app\.biliapi\.net)(?::443)?/x/(?:v2/(?:splash/(?:list|show|event/list2|brand/list)|feed/index(?:/story)?|search/(?:square|trending/ranking|default(?:words)?)|account/mine(?:/ipad)?)|resource/show/tab(?:/v2)?)(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/Bilibili/BilibiliEnhance.js?v=1.11.8,requires-body=true,timeout=10,argument=[{hide_live},{hide_game},{hide_member_shop},{hide_publish},{hide_search_discovery},{blocked_uids},{blocked_keywords},{log_enabled}],tag=Bilibili 广告与推荐过滤
# 功能：其他 app 主机响应只记录元数据，不读取正文；显式排除上面的 JSON 接口，避免重复记录。更新时间：2026-10-07
http-response ^https://app\.bilibili\.com(?::443)?/(?!bilibili\.app\.(?:view\.v1\.View/(?:View|RelatesFeed|ViewProgress|PlayerRelates|ContinuousPlay)|viewunite\.v1\.View/(?:View|RelatesFeed|ViewProgress))(?:\?|$))(?!bilibili\.community\.service\.dm\.v1\.DM/DmView(?:\?|$))(?!bilibili\.app\.interface\.v1\.Search/DefaultWords(?:\?|$))(?!x/(?:v2/(?:splash/(?:list|show|event/list2|brand/list)|feed/index(?:/story)?|search/(?:square|trending/ranking|default(?:words)?)|account/mine(?:/ipad)?)|resource/show/tab(?:/v2)?)(?:\?|$))[^#]*$ script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/Bilibili/BilibiliEnhance.js?v=1.11.8,requires-body=false,timeout=10,enable={log_enabled},argument=[{log_enabled}],tag=Bilibili 开发元数据日志
# 功能：数据主机仅记录安全元数据和白名单路径提示，不读取正文，不阻断流量。
http-response ^https://data\.bilibili\.com(?::443)?/[^#]*$ script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/Bilibili/BilibiliEnhance.js?v=1.11.8,requires-body=false,timeout=10,enable={log_enabled},argument=[{log_enabled}],tag=Bilibili 数据接口元数据日志
# 功能：已登记游戏服务主机仅记录请求和响应安全元数据，便于核对开屏时间；不读取正文，不阻断流量。
http-request ^https://(?:impression|static|game-data-api)\.biligame\.com(?::443)?/[^#]*$ script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/Bilibili/BilibiliEnhance.js?v=1.11.8,requires-body=false,timeout=10,enable={log_enabled},argument=[{log_enabled}],tag=Bilibili 游戏服务请求元数据日志
http-response ^https://(?:impression|static|game-data-api)\.biligame\.com(?::443)?/[^#]*$ script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/Bilibili/BilibiliEnhance.js?v=1.11.8,requires-body=false,timeout=10,enable={log_enabled},argument=[{log_enabled}],tag=Bilibili 游戏服务响应元数据日志
# 功能：视频详情及后续推荐共用 UID／标题黑名单，并默认清理广告及三连／关注浮层；保留未知字段，无新增开关。更新时间：2026-10-07
http-request ^https://(?:app\.bilibili\.com|grpc\.biliapi\.net|app\.biliapi\.net)(?::443)?/(?:bilibili\.app\.(?:view\.v1\.View/(?:View|RelatesFeed|ViewProgress|PlayerRelates|ContinuousPlay)|viewunite\.v1\.View/(?:View|RelatesFeed|ViewProgress))|bilibili\.community\.service\.dm\.v1\.DM/DmView)(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/Bilibili/BilibiliEnhance.js?v=1.11.8,requires-body=false,timeout=10,tag=Bilibili 视频广告压缩协商
http-response ^https://(?:app\.bilibili\.com|grpc\.biliapi\.net|app\.biliapi\.net)(?::443)?/(?:bilibili\.app\.(?:view\.v1\.View/(?:View|RelatesFeed|ViewProgress|PlayerRelates|ContinuousPlay)|viewunite\.v1\.View/(?:View|RelatesFeed|ViewProgress))|bilibili\.community\.service\.dm\.v1\.DM/DmView)(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/Bilibili/BilibiliEnhance.js?v=1.11.8,requires-body=true,binary-body-mode=true,timeout=10,argument=[{hide_live},{blocked_uids},{blocked_keywords},{log_enabled}],tag=Bilibili 视频页广告过滤
# 功能：只删除网页弹幕元数据中的三连／关注指令，保留其他弹幕与字幕。更新时间：2026-10-07
http-response ^https://api\.bilibili\.com(?::443)?/x/v2/dm/web/view(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/Bilibili/BilibiliEnhance.js?v=1.11.8,requires-body=true,binary-body-mode=true,timeout=10,argument=[{log_enabled}],tag=Bilibili 三连互动浮层过滤
# 功能：仅本地响应默认词 RPC，不读取请求正文；搜索结果和输入联想不受影响。更新时间：2026-10-07
http-request ^https://(?:app\.bilibili\.com|grpc\.biliapi\.net|app\.biliapi\.net)(?::443)?/bilibili\.app\.interface\.v1\.Search/DefaultWords(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/Bilibili/BilibiliEnhance.js?v=1.11.8,requires-body=false,timeout=10,argument=[{log_enabled}],tag=Bilibili 搜索框默认词清空
http-request ^http://bilibili-logs\.invalid(?::80)?(?:/[^#]*)?$ script-path=https://raw.githubusercontent.com/teaoea/shell/main/plugins/Bilibili/BilibiliEnhance.js?v=1.11.8,requires-body=true,timeout=10,argument=[{log_enabled}],tag=Bilibili 本地管理页面

[Mitm]
hostname = app.bilibili.com,grpc.biliapi.net,app.biliapi.net,api.bilibili.com,data.bilibili.com,impression.biligame.com,static.biligame.com,game-data-api.biligame.com
