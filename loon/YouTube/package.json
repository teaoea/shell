{
  "name": "loon-youtube-scripts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:check": "node tools/build.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "test:dist": "node --import ./tools/minified-runtime.mjs --test tests/*.test.mjs",
    "verify": "node tools/build.mjs --check && node --test tests/*.test.mjs && node --import ./tools/minified-runtime.mjs --test tests/*.test.mjs"
  },
  "devDependencies": {
    "terser": "5.51.2"
  }
}
