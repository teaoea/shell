#!name = YouTube日志导出
#!desc = 本地收集去广告处理结果，浏览器访问 http://youtube-logs.invalid/ 下载日志

[Script]
generic script-path=https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/YouTubeLogger.js,timeout=10,tag=YouTube 日志入口
http-request ^http:\/\/youtube-logs\.invalid(?::80)?(?:\/[^#]*)?$ script-path=https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/YouTubeLogger.js,requires-body=false,timeout=10,tag=YouTube 日志下载

# 在 Loon 手动运行“ YouTube 日志入口 ”，点击通知打开本地页面。
# 页面上点“开始记录”后收集；停用插件前先点“暂停记录”。
# 不添加 YouTube 响应脚本，避免与去广告插件抢占相同请求。
