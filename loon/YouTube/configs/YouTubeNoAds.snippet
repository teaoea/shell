# YouTube 共享底层 1.0.0：加入 Quantumult X 的 [rewrite_local]，或作为复写资源引用。
# 字幕目标仅 zh-CN / en-US；编辑 URL # 后参数。log_enabled 关闭时媒体不采样。
# initplayback 原样放行：不移植 Loon 的 reject_video(200)，未完成圈 X 实机验证。
^https://(?:www\.|m\.)?youtube\.com/api/timedtext\?[^#]+$ url script-request-header https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/dist/request.min.js#background_playback=false&hide_home_shorts=false&translation_target=zh-CN&playback_region=original&log_enabled=false&log_level=info&capture_budget=16
^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)/youtubei/v1/player/ad_break(?:\?[^#]*)?$ url script-echo-response https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/dist/request.min.js#background_playback=false&hide_home_shorts=false&translation_target=zh-CN&playback_region=original&log_enabled=false&log_level=info&capture_budget=16&echo_response=true
^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)/youtubei/v1/(?:player|get_watch|log_event)(?:\?[^#]*)?$ url script-request-body https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/dist/request.min.js#background_playback=false&hide_home_shorts=false&translation_target=zh-CN&playback_region=original&log_enabled=false&log_level=info&capture_budget=16
^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)/youtubei/v1/(?:browse|next|search|player|get_watch|config|log_event|reel/reel_watch_sequence)(?:\?[^#]*)?$ url script-response-body https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/dist/response.min.js#background_playback=false&hide_home_shorts=false&translation_target=zh-CN&playback_region=original&log_enabled=false&log_level=info&capture_budget=16
^https://[\w-]+\.googlevideo\.com/(?:videoplayback|initplayback)(?:\?[^#]*)?$ url script-response-header https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/dist/response.min.js#background_playback=false&hide_home_shorts=false&translation_target=zh-CN&playback_region=original&log_enabled=false&log_level=info&capture_budget=16
^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)/youtubei/v1/(?:browse|next|search|reel/reel_watch_sequence)(?:\?[^#]*)?$ url script-request-header https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/dist/request.min.js#background_playback=false&hide_home_shorts=false&translation_target=zh-CN&playback_region=original&log_enabled=false&log_level=info&capture_budget=16
^http://youtube-logs\.invalid(?::80)?(?:/[^#]*)?$ url script-echo-response https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/dist/request.min.js#background_playback=false&hide_home_shorts=false&translation_target=zh-CN&playback_region=original&log_enabled=false&log_level=info&capture_budget=16&echo_response=true&log_enabled=true
# 在 [mitm] 的 hostname 中追加：youtubei.googleapis.com, youtubei-att.googleapis.com, youtube.com, www.youtube.com, m.youtube.com, music.youtube.com, *.googlevideo.com
# 本资源不配置全局 UDP 丢弃，避免影响其他 App。
