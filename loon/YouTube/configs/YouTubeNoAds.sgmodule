#!name=YouTube 共享底层
# 作者：可莉唯一的狗、ChatGPT + GPT-6.0 / GPT-6.1-sol
#!desc=共享请求响应脚本；字幕与 API 清理。initplayback 放行，未完成 Surge 实机验证。
# 修改各规则 argument 中参数；不要启用两个相同 URL 的同阶段正文脚本。
[Script]
YouTube字幕 = type=http-request,pattern=^https://(?:www\.|m\.)?youtube\.com/api/timedtext\?[^#]+$,requires-body=false,timeout=10,script-path=https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/dist/request.min.js,argument="background_playback=false&hide_home_shorts=false&translation_target=zh-CN&playback_region=original&log_enabled=false&log_level=info&capture_budget=16"
YouTube播放请求 = type=http-request,pattern=^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)/youtubei/v1/(?:player|get_watch|player/ad_break|log_event)(?:\?[^#]*)?$,requires-body=true,binary-body-mode=true,max-size=2097152,timeout=10,script-path=https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/dist/request.min.js,argument="background_playback=false&hide_home_shorts=false&translation_target=zh-CN&playback_region=original&log_enabled=false&log_level=info&capture_budget=16"
YouTubeAPI响应 = type=http-response,pattern=^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)/youtubei/v1/(?:browse|next|search|player|get_watch|config|log_event|reel/reel_watch_sequence)(?:\?[^#]*)?$,requires-body=true,binary-body-mode=true,max-size=2097152,timeout=10,script-path=https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/dist/response.min.js,argument="background_playback=false&hide_home_shorts=false&translation_target=zh-CN&playback_region=original&log_enabled=false&log_level=info&capture_budget=16"
YouTube媒体响应头 = type=http-response,pattern=^https://[\w-]+\.googlevideo\.com/(?:videoplayback|initplayback)(?:\?[^#]*)?$,requires-body=false,timeout=10,script-path=https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/dist/response.min.js,argument="background_playback=false&hide_home_shorts=false&translation_target=zh-CN&playback_region=original&log_enabled=false&log_level=info&capture_budget=16"
YouTube浏览日志 = type=http-request,pattern=^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)/youtubei/v1/(?:browse|next|search|reel/reel_watch_sequence)(?:\?[^#]*)?$,requires-body=false,timeout=10,script-path=https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/dist/request.min.js,argument="background_playback=false&hide_home_shorts=false&translation_target=zh-CN&playback_region=original&log_enabled=false&log_level=info&capture_budget=16"
YouTube日志页面 = type=http-request,pattern=^http://youtube-logs\.invalid(?::80)?(?:/[^#]*)?$,requires-body=false,timeout=10,script-path=https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/dist/request.min.js,argument="background_playback=false&hide_home_shorts=false&translation_target=zh-CN&playback_region=original&log_enabled=true&log_level=info&capture_budget=16"
[MITM]
hostname = %APPEND% youtubei.googleapis.com, youtubei-att.googleapis.com, youtube.com, www.youtube.com, m.youtube.com, music.youtube.com, *.googlevideo.com
