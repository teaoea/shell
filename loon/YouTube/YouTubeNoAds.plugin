#!name = YouTube去广告
#!desc = 用于 YouTube App 广告处理：清理已识别的首页、推荐及搜索赞助卡片（含已适配的 iOS EML 视频、竖图、方图、图片轮播及带底部按钮的广告）和播放接口广告位，可手动开启后台播放、隐藏首页 Shorts 推荐区，提供 UMP 视频流广告预取提示清理试验，并支持分级日志、开发抓包和文件导出。需开启 MitM 并信任证书；后台播放、隐藏 Shorts、UMP、日志和抓包默认关闭。直播、受限内容和 UMP 去广告效果仍由 YouTube 实际响应决定；抓包可能增加播放等待。
#!icon = https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/assets/youtube.png
#!homepage = https://github.com/teaoea/shell/blob/main/loon/YouTube/README.md
#!tag = YouTube,去广告,开发日志

[Argument]
background_playback = switch,false,tag=后台播放,desc=开启后允许普通视频在切换 App 或锁屏后继续播放音频；直播和受限内容仍由 YouTube 决定
hide_home_shorts = switch,false,tag=隐藏首页 Shorts,desc=开启后移除首页 Shorts 推荐区；保留底部 Shorts 入口和其他页面
script_debug = switch,false,tag=控制台日志,desc=需要查看 Loon 脚本日志时手动开启
log_enabled = switch,false,tag=日志工具,desc=手动开启后访问日志页面开始记录；关闭即停止写入
log_level = select,"info","debug","warn","error",tag=日志保存级别,desc=仅保存此级别及更高严重程度；排查 UMP 请选择 debug
capture_raw = switch,false,tag=开发抓包,desc=手动开启后保存完整 URL、请求头及二进制正文；含账号或签名信息，仅用于本地开发
capture_budget = select,"32","16","64",tag=开发抓包容量 MB,desc=达到上限停止记录，保留已有样本；导出后再清空
ump_enabled = switch,false,tag=UMP 试验处理,desc=先用 inspect 取日志；完整读取播放响应可能增加等待
ump_mode = select,"inspect","clean_prefetch",tag=UMP 模式,desc=inspect 仅检查；clean_prefetch 清理广告预取提示，未验证实播

[Rule]
# 只促使 API 接口的 QUIC 回退到 TCP；不处理 googlevideo 播放媒体。
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Script]
http-request ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:player|get_watch|browse|next|search)(?:\?[^#]*)?$|^https:\/\/[\w-]+\.googlevideo\.com\/videoplayback\?[^#]*$ script-path=https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/YouTubeLogger.js,requires-body=true,binary-body-mode=true,timeout=10,enable={capture_raw},argument=[{log_enabled},{log_level},{capture_raw},{capture_budget},{ump_enabled},{ump_mode},{background_playback}],tag=YouTube 开发请求抓包
http-response ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(browse|next|search)(\?[^#]*)?$ script-path=https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/YouTubeFeedAds.js,requires-body=true,binary-body-mode=true,timeout=10,debug={script_debug},argument=[{script_debug},{log_enabled},{log_level},{capture_raw},{capture_budget},{hide_home_shorts}],tag=YouTube 信息流广告与首页 Shorts 处理
http-response ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(player|get_watch)(\?[^#]*)?$ script-path=https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/YouTubePlaybackAds.js,requires-body=true,binary-body-mode=true,timeout=10,debug={script_debug},argument=[{script_debug},{log_enabled},{log_level},{capture_raw},{capture_budget},{background_playback}],tag=YouTube 播放广告位清理与后台播放
http-response ^https:\/\/[\w-]+\.googlevideo\.com\/videoplayback\?[^#]*$ script-path=https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/YouTubeStreamAds.js,requires-body=true,binary-body-mode=true,timeout=10,enable={ump_enabled},debug={script_debug},argument=[{script_debug},{ump_enabled},{ump_mode},{log_enabled},{log_level},{capture_raw},{capture_budget}],tag=YouTube 视频流广告提示清理（试验）

generic script-path=https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/YouTubeLogger.js,timeout=10,enable={log_enabled},argument=[{log_enabled},{log_level},{capture_raw},{capture_budget}],tag=YouTube 日志入口

http-request ^http:\/\/youtube-logs\.invalid(?::80)?(?:\/[^#]*)?$ script-path=https://raw.githubusercontent.com/teaoea/shell/main/loon/YouTube/YouTubeLogger.js,requires-body=false,timeout=10,enable={log_enabled},argument=[{log_enabled},{log_level},{capture_raw},{capture_budget}],tag=YouTube 日志下载

[Mitm]
hostname = youtubei.googleapis.com, youtubei-att.googleapis.com, youtube.com, www.youtube.com, m.youtube.com, music.youtube.com, *.googlevideo.com
# UMP 试验入口默认关闭；媒体域名的 MitM 仍生效，完整撤销需移除该 hostname。
# 先确认播放请求走 TCP；默认不对媒体添加 UDP 拒绝规则。
