#!name = 闲鱼推送网络辅助
#!desc = 闲鱼及 Apple 推送连接直连辅助；新增图标和本地开发日志，开启后仅采集带闲鱼客户端标识的 HTTP 请求、响应和 URL／字面 IP，统一导出开发样本；不以共享域名判断 App 来源。Header 识别不等于进程归属证明，无法采集所有纯 IP 连接。日志需 Loon Build 983+，正文需 MitM。不能唤醒闲鱼、防止后台回收或维持卖家在线；效果待实机验证。
#!icon = https://raw.githubusercontent.com/teaoea/shell/main/loon/Xianyu/assets/xianyu.jpg
#!tag = 闲鱼,推送,网络排查,开发日志
#!system = iOS,iPadOS
#!homepage = https://github.com/teaoea/shell/blob/main/loon/Xianyu/README.md

[Argument]
log_enabled = switch,false,tag=开发日志,desc=开启后记录请求与响应，暂停或关闭后仍可导出；建议短时间复现广告后立即导出
capture_budget = select,"32","16","64","128",tag=日志容量 MB,desc=达到容量或 4096 条事件上限停止，保留已有记录；导出后再清空
body_limit_kb = select,"1024","256","4096",tag=单份正文上限 KB,desc=超限正文不保存并注明原因；读取完整正文会增加内存及等待，短时间采集后关闭
raw_binary = switch,true,tag=保存未知二进制,desc=以 Base64 保留未知协议样本用于开发；无法保证脱敏，日志仅在本机保存
media_body = switch,false,tag=保存图片音视频正文,desc=默认只记录媒体 URL 和请求响应头；开启时读取完整媒体再按正文上限保存，可能增加等待及内存

[Rule]
# 闲鱼官网及其子域名，覆盖 acs.m.goofish.com、h5api.m.goofish.com、
# passport.goofish.com 等业务接口；按域名分流，无需解密 HTTPS URL。
# 来源：https://www.goofish.com/
# 接口参考：https://github.com/shaxiu/XianyuAutoAgent/blob/main/XianyuApis.py
DOMAIN-SUFFIX,goofish.com,DIRECT

# 已确认的闲鱼网页版 WebSocket 消息端点；不代表 iOS App 必然使用它。
# 来源：https://github.com/shaxiu/XianyuAutoAgent/blob/main/main.py
DOMAIN,wss-goofish.dingtalk.com,DIRECT

# 闲鱼使用的淘宝共享接口网关；同一主机上其他 App 的请求也会直连。
# 精确匹配主机，便于在无需 MitM 时覆盖 HTTPS；不将 taobao.com 全站直连。
# 参考：https://github.com/Thelongdarkorg/loon-plugins
DOMAIN,acs.m.taobao.com,DIRECT

# Apple 推送域名；已有本地域名规则优先于插件规则。
DOMAIN-SUFFIX,push.apple.com,DIRECT

# 纯 IP 连接兜底，仅覆盖 Apple 公布的 APNs 网段及设备接收端口。
# no-resolve 避免为其他域名额外解析 DNS；不保证覆盖所有 APNs 地址。
# 来源：https://support.apple.com/zh-cn/102266
# TCP 5223：设备的推送长连接；TCP 443：无法使用 5223 时的回退。
AND,((PROTOCOL,TCP),(DEST-PORT,5223),(IP-CIDR,17.249.0.0/16,no-resolve)),DIRECT
AND,((PROTOCOL,TCP),(DEST-PORT,443),(IP-CIDR,17.249.0.0/16,no-resolve)),DIRECT
AND,((PROTOCOL,TCP),(DEST-PORT,5223),(IP-CIDR,17.252.0.0/16,no-resolve)),DIRECT
AND,((PROTOCOL,TCP),(DEST-PORT,443),(IP-CIDR,17.252.0.0/16,no-resolve)),DIRECT
AND,((PROTOCOL,TCP),(DEST-PORT,5223),(IP-CIDR,17.57.144.0/22,no-resolve)),DIRECT
AND,((PROTOCOL,TCP),(DEST-PORT,443),(IP-CIDR,17.57.144.0/22,no-resolve)),DIRECT
AND,((PROTOCOL,TCP),(DEST-PORT,5223),(IP-CIDR,17.188.128.0/18,no-resolve)),DIRECT
AND,((PROTOCOL,TCP),(DEST-PORT,443),(IP-CIDR,17.188.128.0/18,no-resolve)),DIRECT
AND,((PROTOCOL,TCP),(DEST-PORT,5223),(IP-CIDR,17.188.20.0/23,no-resolve)),DIRECT
AND,((PROTOCOL,TCP),(DEST-PORT,443),(IP-CIDR,17.188.20.0/23,no-resolve)),DIRECT
AND,((PROTOCOL,TCP),(DEST-PORT,5223),(IP-CIDR6,2620:149:a44::/48,no-resolve)),DIRECT
AND,((PROTOCOL,TCP),(DEST-PORT,443),(IP-CIDR6,2620:149:a44::/48,no-resolve)),DIRECT
AND,((PROTOCOL,TCP),(DEST-PORT,5223),(IP-CIDR6,2403:300:a42::/48,no-resolve)),DIRECT
AND,((PROTOCOL,TCP),(DEST-PORT,443),(IP-CIDR6,2403:300:a42::/48,no-resolve)),DIRECT
AND,((PROTOCOL,TCP),(DEST-PORT,5223),(IP-CIDR6,2403:300:a51::/48,no-resolve)),DIRECT
AND,((PROTOCOL,TCP),(DEST-PORT,443),(IP-CIDR6,2403:300:a51::/48,no-resolve)),DIRECT
AND,((PROTOCOL,TCP),(DEST-PORT,5223),(IP-CIDR6,2a01:b740:a42::/48,no-resolve)),DIRECT
AND,((PROTOCOL,TCP),(DEST-PORT,443),(IP-CIDR6,2a01:b740:a42::/48,no-resolve)),DIRECT

[Script]
# 本地工具始终可访问，关闭日志后仍可导出；此入口不连接互联网。
request if ${url} ~= /^http:\/\/xianyu-logs\.invalid(?::80)?(?:\/|$)/ then script("https://raw.githubusercontent.com/teaoea/shell/main/loon/Xianyu/XianyuLogger.js", {${log_enabled}, ${capture_budget}, ${body_limit_kb}, ${raw_binary}, ${media_body}}) with requires_body=true, timeout=30, tag="闲鱼日志页面与导出"
# 先匹配媒体头部模式，避免默认缓冲图片／音视频；其 URL 仍完整进入日志。
request if ${url} ~= /^https?:\/\//i && ${log_enabled} == true && ${request.header['User-Agent']} ~= /(?:^|\s)(?:AliApp\(Fish\/[0-9][\d.]*\)|(?:com\.taobao\.fleamarket|IdleFish|Goofish|闲鱼|%E9%97%B2%E9%B1%BC)\/[0-9][\d.]*)(?=\s|$)/i && ${media_body} == false && ${request.header['Content-Type']} ~= /^(?:image|video|audio)\/|^application\/(?:vnd\.apple\.mpegurl|x-mpegurl)/i then script("https://raw.githubusercontent.com/teaoea/shell/main/loon/Xianyu/XianyuLogger.js", {${log_enabled}, ${capture_budget}, ${body_limit_kb}, ${raw_binary}, ${media_body}}) with enable=${log_enabled}, requires_body=false, timeout=30, tag="闲鱼媒体请求头日志"
request if ${url} ~= /^https?:\/\//i && ${log_enabled} == true && ${request.header['User-Agent']} ~= /(?:^|\s)(?:AliApp\(Fish\/[0-9][\d.]*\)|(?:com\.taobao\.fleamarket|IdleFish|Goofish|闲鱼|%E9%97%B2%E9%B1%BC)\/[0-9][\d.]*)(?=\s|$)/i then script("https://raw.githubusercontent.com/teaoea/shell/main/loon/Xianyu/XianyuLogger.js", {${log_enabled}, ${capture_budget}, ${body_limit_kb}, ${raw_binary}, ${media_body}}) with enable=${log_enabled}, requires_body=true, binary_body_mode=true, timeout=30, tag="闲鱼请求开发日志"
response if ${url} ~= /^https?:\/\//i && ${log_enabled} == true && ${request.header['User-Agent']} ~= /(?:^|\s)(?:AliApp\(Fish\/[0-9][\d.]*\)|(?:com\.taobao\.fleamarket|IdleFish|Goofish|闲鱼|%E9%97%B2%E9%B1%BC)\/[0-9][\d.]*)(?=\s|$)/i && ${media_body} == false && ${response.header['Content-Type']} ~= /^(?:image|video|audio)\/|^application\/(?:vnd\.apple\.mpegurl|x-mpegurl)/i then script("https://raw.githubusercontent.com/teaoea/shell/main/loon/Xianyu/XianyuLogger.js", {${log_enabled}, ${capture_budget}, ${body_limit_kb}, ${raw_binary}, ${media_body}}) with enable=${log_enabled}, requires_body=false, timeout=30, tag="闲鱼媒体响应头日志"
response if ${url} ~= /^https?:\/\//i && ${log_enabled} == true && ${request.header['User-Agent']} ~= /(?:^|\s)(?:AliApp\(Fish\/[0-9][\d.]*\)|(?:com\.taobao\.fleamarket|IdleFish|Goofish|闲鱼|%E9%97%B2%E9%B1%BC)\/[0-9][\d.]*)(?=\s|$)/i then script("https://raw.githubusercontent.com/teaoea/shell/main/loon/Xianyu/XianyuLogger.js", {${log_enabled}, ${capture_budget}, ${body_limit_kb}, ${raw_binary}, ${media_body}}) with enable=${log_enabled}, requires_body=true, binary_body_mode=true, timeout=30, tag="闲鱼响应开发日志"
generic then script("https://raw.githubusercontent.com/teaoea/shell/main/loon/Xianyu/XianyuLogger.js", {${log_enabled}, ${capture_budget}, ${body_limit_kb}, ${raw_binary}, ${media_body}}) with timeout=30, img_url="doc.text.magnifyingglass", tag="闲鱼开发日志"

[Mitm]
# 仅登记已知主机；客户端标识过滤覆盖任意 URL，但未知 HTTPS 主机需要自行补充解密。
# 不包含 Apple 推送主机。共享域名也用于其他 App，调试结束请关闭日志。
hostname = goofish.com, *.goofish.com, acs.m.taobao.com, h5api.m.taobao.com, wss-goofish.dingtalk.com, alicdn.com, *.alicdn.com, mmstat.com, *.mmstat.com, iyes.youku.com, amdc.alipay.com
